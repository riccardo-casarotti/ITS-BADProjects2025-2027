@model BikeStoresProject.Models.Product

@{
    ViewData["Title"] = "Details";
}

<h1>@ViewData["Title"]</h1>

<div class="card shadow-sm" style="max-width: 700px;">
    <div class="card-header bg-dark text-white">
        <h4 class="mb-0">Product</h4>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.ProductName)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.ProductName)
            </dd>

            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.ModelYear)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.ModelYear)
            </dd>

            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.ListPrice)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.ListPrice)
            </dd>

            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Brand)
            </dt>
            <dd class="col-sm-8">
                <span class="badge bg-secondary">@Html.DisplayFor(model => model.Brand.BrandId)</span>
            </dd>

            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Category)
            </dt>
            <dd class="col-sm-8">
                <span class="badge bg-info text-dark">@Html.DisplayFor(model => model.Category.CategoryId)</span>
            </dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">&larr; Back to List</a>
</div>