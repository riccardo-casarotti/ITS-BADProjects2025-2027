@model IEnumerable<BikeStoresProject.Models.Order>

@{
    ViewData["Title"] = "Orders";
}

<h1>@ViewData["Title"]</h1>



<form asp-action="Index" method="get">
    <p>
        Cerca: <input type="text" name="searchTesto" value="@ViewBag.SearchTesto" class="form-control" style="display:inline; width:300px;" placeholder="Cerca N. Ordine, Cliente o Negozio" />
        Dal: <input type="date" name="dataDa" value="@ViewBag.DataDa" class="form-control" style="display:inline; width:180px;" />
        Al: <input type="date" name="dataA" value="@ViewBag.DataA" class="form-control" style="display:inline; width:180px;" />
        <input type="submit" value="Cerca" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-outline-secondary">Rimuovi filtro</a>
    </p>
</form>

<table class="table table-striped table-hover align-middle shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.OrderStatus)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OrderDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ShippedDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Customer.CustomerId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Customer)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Store.StoreName)
            </th>
            <th class="text-center">Azioni</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @{
                    string statusLabel = item.OrderStatus switch
                    {
                        1 => "Aperto",
                        2 => "Evaso",
                        3 => "Rifiutato",
                        4 => "Fatturato",
                        _ => "Sconosciuto"
                    };
                }
                <span class="badge bg-secondary">@statusLabel</span>
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OrderDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ShippedDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Customer.CustomerId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Customer.LastName)
            </td>
            <td>
                <span class="badge bg-info text-dark">@Html.DisplayFor(modelItem => item.Store.StoreName)</span>
            </td>
            <td class="text-center">
                <a asp-action="Details" asp-route-id="@item.OrderId" class="btn btn-sm btn-outline-primary">Details</a>
            </td>
        </tr>
}
    </tbody>
</table>