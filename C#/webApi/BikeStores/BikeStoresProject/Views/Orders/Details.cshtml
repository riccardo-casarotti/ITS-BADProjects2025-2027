@model BikeStoresProject.Models.Order

@{
    ViewData["Title"] = "Details";
}

<h1>@ViewData["Title"]</h1>

<div class="card shadow-sm" style="max-width: 700px;">
    <div class="card-header bg-dark text-white">
        <h4 class="mb-0">Order</h4>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.OrderStatus)
            </dt>
            <dd class="col-sm-8">
                @{
                    string statusLabel = Model.OrderStatus switch
                    {
                        1 => "Aperto",
                        2 => "Evaso",
                        3 => "Rifiutato",
                        4 => "Fatturato",
                        _ => "Sconosciuto"
                    };
                }
                <span class="badge bg-secondary">@statusLabel</span>
            </dd>

            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.OrderDate)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.OrderDate)
            </dd>

            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.ShippedDate)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.ShippedDate)
            </dd>

            <dt class="col-sm-4">
                Customer ID
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Customer.CustomerId)
            </dd>

            <dt class="col-sm-4">
                Customer
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Customer.FirstName) @Html.DisplayFor(model => model.Customer.LastName)
            </dd>

            <dt class="col-sm-4">
                Staff ID
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Staff.StaffId)
            </dd>

            <dt class="col-sm-4">
                Staff
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Staff.FirstName) @Html.DisplayFor(model => model.Staff.LastName)
            </dd>

            <dt class="col-sm-4">
                Store ID
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Store.StoreId)
            </dd>

            <dt class="col-sm-4">
                Store
            </dt>
            <dd class="col-sm-8">
                <span class="badge bg-info text-dark">@Html.DisplayFor(model => model.Store.StoreName)</span>
            </dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">&larr; Back to List</a>
</div>